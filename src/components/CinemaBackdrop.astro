---
/**
 * Full-page cinema backdrop. The film sits fixed behind the entire page and
 * the whole document scroll drives the playhead: the camera reaches each
 * stone as the visitor reaches that stone's section. Anchors are measured
 * from the real section positions, so the mapping survives any content edit.
 *
 * Falls back to the static hero image when the video cannot play, when JS is
 * disabled, or when the visitor prefers reduced motion.
 */
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---

<div class="backdrop" aria-hidden="true">
  <video
    class="backdrop-video"
    src="/cinema.mp4"
    poster="/cinema-poster.jpg"
    data-landscape-src="/cinema.mp4"
    data-landscape-poster="/cinema-poster.jpg"
    data-portrait-src="/cinema-portrait.mp4"
    data-portrait-poster="/cinema-poster-portrait.jpg"
    muted
    playsinline
    preload="auto"
    tabindex="-1"
  ></video>
  <div class="backdrop-fallback">
    <Picture
      src={heroImage}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      formats={['avif', 'webp']}
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="backdrop-scrim"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .backdrop-video,
  .backdrop-fallback,
  .backdrop-fallback :global(picture),
  .backdrop-fallback :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .backdrop-fallback {
    z-index: -1;
  }

  .backdrop.no-video .backdrop-video {
    display: none;
  }

  .backdrop-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.35) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 30%, transparent), transparent 30%);
  }
</style>

<script>
  const backdrop = document.querySelector<HTMLElement>('.backdrop');
  const video = backdrop?.querySelector<HTMLVideoElement>('.backdrop-video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const smooth = (t: number) => t * t * (3 - 2 * t);

  if (!backdrop || !video || reducedMotion) {
    backdrop?.classList.add('no-video');
  } else {
    video.addEventListener('error', () => backdrop.classList.add('no-video'));

    let duration = 0;
    let shownTime = -1;
    let orientation: 'portrait' | 'landscape' | null = null;
    let keys: Array<{ p: number; t: number }> = [{ p: 0, t: 0 }, { p: 1, t: 1 }];

    function applyOrientation() {
      const next = window.innerHeight > window.innerWidth ? 'portrait' : 'landscape';
      if (next === orientation) return;
      orientation = next;
      const src = video!.dataset[`${next}Src`];
      const poster = video!.dataset[`${next}Poster`];
      if (src && video!.getAttribute('src') !== src) {
        duration = 0;
        shownTime = -1;
        if (poster) video!.setAttribute('poster', poster);
        video!.setAttribute('src', src);
        video!.load();
      }
    }

    /**
     * Build the scroll→time map from the real section positions. Each stone
     * section contributes a pair of keys (arrive / leave), giving the camera
     * a slow drift across its facets while that stone is on screen.
     */
    function measure() {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      if (total <= 0) return;
      const vh = window.innerHeight;
      const at = (y: number) => Math.min(1, Math.max(0, y / total));
      const top = (el: Element) => el.getBoundingClientRect().top + window.scrollY;

      const next: Array<{ p: number; t: number }> = [{ p: 0, t: 0 }];
      const collection = document.getElementById('collection');
      if (collection) next.push({ p: at(top(collection) - vh * 0.6), t: 0.05 });

      const stops: Array<[string, number]> = [
        ['stone-i', 0.31],
        ['stone-ii', 0.62],
        ['stone-iii', 0.92],
      ];
      for (const [id, t] of stops) {
        const el = document.getElementById(id);
        if (!el) continue;
        next.push({ p: at(top(el) - vh * 0.55), t });
        next.push({ p: at(top(el) + el.offsetHeight - vh * 0.9), t: t + 0.03 });
      }
      next.push({ p: 1, t: 1 });

      // Keep progress strictly increasing so interpolation stays valid.
      let prev = -1;
      keys = next
        .map((k) => {
          const p = Math.max(k.p, prev + 0.001);
          prev = p;
          return { p, t: Math.min(1, k.t) };
        })
        .filter((k) => k.p <= 1.001);
    }

    function timeFraction(p: number): number {
      for (let i = 1; i < keys.length; i++) {
        const a = keys[i - 1];
        const b = keys[i];
        if (p <= b.p) {
          const local = Math.min(1, Math.max(0, (p - a.p) / (b.p - a.p)));
          return a.t + (b.t - a.t) * smooth(local);
        }
      }
      return keys[keys.length - 1]?.t ?? 1;
    }

    function render() {
      if (duration > 0) {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const p = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
        const target = timeFraction(p) * duration;
        const current = shownTime < 0 ? target : shownTime;
        const next = current + (target - current) * 0.14;
        if (Math.abs(next - (shownTime < 0 ? -1 : shownTime)) > 1 / 120) {
          shownTime = next;
          try {
            video!.currentTime = shownTime;
          } catch {
            /* seek not ready yet */
          }
        }
      }
      requestAnimationFrame(render);
    }

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration || 0;
    });
    if (video.readyState >= 1) {
      duration = video.duration || 0;
    }

    window.addEventListener(
      'resize',
      () => {
        applyOrientation();
        measure();
      },
      { passive: true }
    );
    window.addEventListener('load', measure);
    // Late layout shifts (fonts, images) move the anchors — re-measure once settled.
    setTimeout(measure, 1500);

    applyOrientation();
    measure();
    requestAnimationFrame(render);
  }
</script>
