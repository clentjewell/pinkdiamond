---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---

<section class="hero" id="top">
  <div class="hero-media" aria-hidden="false">
    <Picture
      src={heroImage}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      formats={['avif', 'webp']}
      alt="Three Argyle pink diamonds arranged on dark velvet under studio lighting"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>
  <div class="container hero-copy">
    <p class="eyebrow">Private Treaty Sale</p>
    <h1>Three Argyle Pink Diamonds</h1>
    <p class="hero-lede prose">
      The Argyle mine closed in November 2020. No new supply exists. Offered here are three
      certified Argyle pink diamonds, each accompanied by its Argyle certificate, GIA report and
      independent valuation, available by private treaty to qualified buyers.
    </p>
    <div class="hero-actions">
      <a class="button-primary" href="#collection">View the Collection</a>
      <a class="button-ghost" href="#enquiry">Register Interest</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 56rem);
    display: flex;
    align-items: flex-end;
    padding-block: 0 clamp(3rem, 8vw, 6rem);
    isolation: isolate;
  }

  .hero-media,
  .hero-media :global(picture),
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--bg) 4%, color-mix(in srgb, var(--bg) 55%, transparent) 45%, color-mix(in srgb, var(--bg) 25%, transparent) 100%);
  }

  .hero-copy {
    width: 100%;
    padding-top: 30vh;
  }

  .hero-lede {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .button-primary,
  .button-ghost {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.85rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--accent-deep);
  }

  .button-primary {
    background: var(--accent);
    color: #241318;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--text);
    color: #241318;
  }

  .button-ghost {
    color: var(--text);
  }

  .button-ghost:hover,
  .button-ghost:focus-visible {
    border-color: var(--text);
  }
</style>
