---
/**
 * Scroll-driven cinema. The film itself lives on a fixed, full-viewport
 * layer behind the whole page, so it continues behind every later section
 * with no seam where the intro ends. The pinned track and its stage cards
 * work exactly as before: scrolling the track scrubs the playhead, cards
 * fade in over each stone, and after the track the film simply holds its
 * final frame behind the rest of the page.
 *
 * Falls back to the static hero image (also fixed) when the video cannot
 * play, when JS is disabled, or when the visitor prefers reduced motion.
 */
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import { stones } from '../data/stones';
---

<section class="cinema" id="top" aria-label="Introduction">
  <div class="cinema-backdrop" aria-hidden="true">
    <div class="cinema-fallback">
      <Picture
        src={heroImage}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        formats={['avif', 'webp']}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <video
      class="cinema-video"
      src="/cinema.mp4"
      poster="/cinema-poster.jpg"
      data-landscape-src="/cinema.mp4"
      data-landscape-poster="/cinema-poster.jpg"
      data-portrait-src="/cinema-portrait.mp4"
      data-portrait-poster="/cinema-poster-portrait.jpg"
      muted
      playsinline
      preload="auto"
      tabindex="-1"
    ></video>
    <div class="cinema-scrim"></div>
  </div>

  <div class="cinema-track">
    <div class="cinema-viewport">
      <div class="stage stage-intro is-active" data-stage="intro">
        <div class="container">
          <p class="eyebrow">Private Treaty Sale</p>
          <h1>Three Argyle Pink Diamonds</h1>
          <p class="stage-lede">
            The Argyle mine closed in November 2020. No new supply exists. Three certified
            stones, offered by private treaty.
          </p>
          <p class="scroll-cue" aria-hidden="true"><span></span>Scroll</p>
        </div>
      </div>

      {
        stones.map((stone, i) => (
          <div class="stage stage-stone" data-stage={`stone-${i}`}>
            <div class="container">
              <div class="stone-card">
                <p class="eyebrow">
                  {stone.name} <span class="stage-count">{i + 1} / {stones.length}</span>
                </p>
                <p class="stone-card-title">Argyle Pink Diamond</p>
                <dl class="stone-card-specs">
                  <div>
                    <dt>Carat</dt>
                    <dd>{stone.carat}</dd>
                  </div>
                  <div>
                    <dt>Argyle colour grade</dt>
                    <dd>{stone.argyleColourGrade}</dd>
                  </div>
                  <div>
                    <dt>Clarity</dt>
                    <dd>{stone.clarity}</dd>
                  </div>
                </dl>
                <a class="stone-card-link" href={`#${stone.id}`}>
                  Full specifications
                </a>
              </div>
            </div>
          </div>
        ))
      }

      <div class="stage stage-outro" data-stage="outro">
        <div class="container">
          <p class="eyebrow">The Collection</p>
          <p class="stage-lede">
            Each stone is accompanied by its Argyle certificate, GIA report and independent
            valuation.
          </p>
          <div class="outro-actions">
            <a class="button-primary" href="#collection">View the Collection</a>
            <a class="button-ghost" href="#enquiry">Register Interest</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The film layer sits fixed behind the entire page. */
  .cinema-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .cinema-video,
  .cinema-fallback,
  .cinema-fallback :global(picture),
  .cinema-fallback :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cinema.no-video .cinema-video {
    display: none;
  }

  .cinema-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.3) 100%),
      linear-gradient(
        to top,
        color-mix(in srgb, var(--bg) 35%, transparent),
        transparent 45%
      );
  }

  .cinema-track {
    /* Tall track: scrolling through it drives the video playhead. */
    height: 320vh;
  }

  /* Phones scroll by thumb — keep the sequence shorter so it doesn't drag. */
  @media (max-width: 700px) {
    .cinema-track {
      height: 230vh;
    }
  }

  .cinema-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .cinema.no-video .cinema-track {
    height: auto;
  }

  .cinema.no-video .cinema-viewport {
    position: relative;
  }

  .cinema.no-video .stage-stone,
  .cinema.no-video .stage-outro {
    display: none;
  }

  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 9vh, 6rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: opacity, transform;
  }

  /* Static state used before JS runs and in the no-video fallback. Once the
     scrub script is driving, inline styles take over. */
  .stage.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .stage .container {
    width: 100%;
  }

  .stage-lede {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
  }

  .scroll-cue {
    margin-top: 2.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .scroll-cue span {
    display: block;
    width: 1px;
    height: 2.4rem;
    background: linear-gradient(to bottom, transparent, var(--accent));
    transform-origin: top;
    animation: cue 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes cue {
    0%,
    100% {
      transform: scaleY(0.45);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue span {
      animation: none;
    }
  }

  .stone-card {
    max-width: 24rem;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    border-radius: 3px;
    padding: 1.75rem 2rem 2rem;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
  }

  /* Cheaper compositing on phone GPUs: lighter blur, more opaque panel. */
  @media (max-width: 700px) {
    .stone-card {
      max-width: none;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 1.4rem 1.5rem 1.6rem;
    }

    .stone-card-title {
      font-size: 1.4rem;
    }

    .stage {
      padding-bottom: clamp(2.25rem, 7vh, 4rem);
    }
  }

  .stage-count {
    color: var(--text-muted);
    letter-spacing: 0.2em;
    margin-left: 0.6rem;
    font-size: 0.65rem;
  }

  .stone-card-title {
    font-family: var(--serif);
    font-size: 1.7rem;
    margin-top: 0.5rem;
  }

  .stone-card-specs {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }

  .stone-card-specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    padding-bottom: 0.65rem;
  }

  .stone-card-specs dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .stone-card-specs dd {
    font-size: 0.85rem;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .stone-card-link {
    display: inline-block;
    margin-top: 1.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .outro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .button-primary,
  .button-ghost {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.85rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--accent-deep);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease;
  }

  .button-primary {
    background: var(--accent);
    color: #241318;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--text);
    color: #241318;
  }

  .button-ghost {
    color: var(--text);
  }

  .button-ghost:hover,
  .button-ghost:focus-visible {
    border-color: var(--text);
  }
</style>

<script>
  const cinema = document.querySelector<HTMLElement>('.cinema');
  const track = cinema?.querySelector<HTMLElement>('.cinema-track');
  const video = cinema?.querySelector<HTMLVideoElement>('.cinema-video');
  const stages = cinema ? Array.from(cinema.querySelectorAll<HTMLElement>('.stage')) : [];

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Smooth ease used for camera travel and card fades. */
  const smooth = (t: number) => t * t * (3 - 2 * t);

  /**
   * Playhead map: scroll progress → video time fraction.
   * "move" segments ease between stones; "drift" segments keep a very slow
   * creep while a card is displayed so the frame never feels frozen.
   */
  const TIME_SEGMENTS: Array<{ from: number; to: number; a: number; b: number; ease: boolean }> = [
    { from: 0.0, to: 0.16, a: 0.0, b: 0.045, ease: false }, // intro drift
    { from: 0.16, to: 0.26, a: 0.045, b: 0.3, ease: true }, // travel to stone I
    { from: 0.26, to: 0.42, a: 0.3, b: 0.345, ease: false }, // drift on stone I
    { from: 0.42, to: 0.52, a: 0.345, b: 0.6, ease: true }, // travel to stone II
    { from: 0.52, to: 0.68, a: 0.6, b: 0.645, ease: false }, // drift on stone II
    { from: 0.68, to: 0.78, a: 0.645, b: 0.9, ease: true }, // travel to stone III
    { from: 0.78, to: 0.92, a: 0.9, b: 0.94, ease: false }, // drift on stone III
    { from: 0.92, to: 1.0, a: 0.94, b: 1.0, ease: true }, // settle
  ];

  /**
   * Card visibility ramps: [fade-in start, fully visible, start fading, gone].
   * Ramps are generous and symmetric, so scrolling back rewinds gracefully.
   */
  const STAGE_BANDS: Record<string, [number, number, number, number]> = {
    intro: [-1, 0, 0.08, 0.17],
    'stone-0': [0.21, 0.28, 0.37, 0.44],
    'stone-1': [0.47, 0.54, 0.63, 0.7],
    'stone-2': [0.73, 0.8, 0.87, 0.915],
    outro: [0.93, 0.985, 2, 3],
  };

  function stageOpacity(stage: string, p: number): number {
    const band = STAGE_BANDS[stage];
    if (!band) return 0;
    const [inStart, inEnd, outStart, outEnd] = band;
    if (p <= inStart || p >= outEnd) return 0;
    if (p < inEnd) return smooth((p - inStart) / (inEnd - inStart));
    if (p > outStart) return 1 - smooth((p - outStart) / (outEnd - outStart));
    return 1;
  }

  function timeFraction(p: number): number {
    for (const s of TIME_SEGMENTS) {
      if (p <= s.to) {
        const local = Math.min(1, Math.max(0, (p - s.from) / (s.to - s.from)));
        return s.a + (s.b - s.a) * (s.ease ? smooth(local) : local);
      }
    }
    return 1;
  }

  function disableCinema() {
    cinema?.classList.add('no-video');
    for (const el of stages) {
      el.style.opacity = '';
      el.style.visibility = '';
      el.style.transform = '';
    }
  }

  if (!cinema || !track || !video || reducedMotion) {
    disableCinema();
  } else {
    video.addEventListener('error', disableCinema);

    let duration = 0;
    let progress = 0;
    let shownTime = -1;
    let orientation: 'portrait' | 'landscape' | null = null;

    // Portrait phones get a 9:16 recomposition of the film so all three
    // stones stay in frame; landscape screens keep the 16:9 original.
    function applyOrientation() {
      const next = window.innerHeight > window.innerWidth ? 'portrait' : 'landscape';
      if (next === orientation) return;
      orientation = next;
      const src = video!.dataset[`${next}Src`];
      const poster = video!.dataset[`${next}Poster`];
      if (src && video!.getAttribute('src') !== src) {
        duration = 0;
        shownTime = -1;
        if (poster) video!.setAttribute('poster', poster);
        video!.setAttribute('src', src);
        video!.load();
      }
    }

    function readScroll() {
      const rect = track!.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    }

    function render() {
      // Weighted playhead: glide toward the scroll target rather than snap.
      if (duration > 0) {
        const target = timeFraction(progress) * duration;
        const current = shownTime < 0 ? target : shownTime;
        const next = current + (target - current) * 0.14;
        if (Math.abs(next - (shownTime < 0 ? -1 : shownTime)) > 1 / 120) {
          shownTime = next;
          try {
            video!.currentTime = shownTime;
          } catch {
            /* seek not ready yet */
          }
        }
      }

      // Continuous, symmetric card fades driven directly by scroll.
      for (const el of stages) {
        const stage = el.dataset.stage ?? '';
        const o = stageOpacity(stage, progress);
        el.style.opacity = o.toFixed(3);
        el.style.visibility = o > 0.001 ? 'visible' : 'hidden';
        el.style.transform = `translateY(${((1 - o) * 14).toFixed(2)}px)`;
        el.style.pointerEvents = o > 0.55 ? 'auto' : 'none';
        el.classList.remove('is-active');
      }

      requestAnimationFrame(render);
    }

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration || 0;
    });
    if (video.readyState >= 1) {
      duration = video.duration || 0;
    }

    window.addEventListener('scroll', readScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        applyOrientation();
        readScroll();
      },
      { passive: true }
    );

    applyOrientation();
    readScroll();
    requestAnimationFrame(render);
  }
</script>
