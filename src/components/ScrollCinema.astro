---
/**
 * Scroll-driven cinema hero. A pinned full-viewport video is scrubbed by the
 * scroll position: it opens paused on all three stones, then the playhead
 * travels to each stone in turn while that stone's summary card fades in.
 * The mapping holds the playhead still (a plateau) while each card is up.
 *
 * Falls back to the static hero image when the video cannot play, when JS is
 * disabled, or when the visitor prefers reduced motion.
 */
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import { stones } from '../data/stones';
---

<section class="cinema" id="top" aria-label="Introduction">
  <div class="cinema-track">
    <div class="cinema-viewport">
      <video
        class="cinema-video"
        src="/cinema.mp4"
        poster="/cinema-poster.jpg"
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>

      <div class="cinema-fallback">
        <Picture
          src={heroImage}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          formats={['avif', 'webp']}
          alt="Three Argyle pink diamonds arranged on dark velvet under studio lighting"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="cinema-scrim" aria-hidden="true"></div>

      <div class="stage stage-intro is-active" data-stage="intro">
        <div class="container">
          <p class="eyebrow">Private Treaty Sale</p>
          <h1>Three Argyle Pink Diamonds</h1>
          <p class="stage-lede">
            The Argyle mine closed in November 2020. No new supply exists. Three certified
            stones, offered by private treaty.
          </p>
          <p class="scroll-cue" aria-hidden="true"><span></span>Scroll</p>
        </div>
      </div>

      {
        stones.map((stone, i) => (
          <div class="stage stage-stone" data-stage={`stone-${i}`}>
            <div class="container">
              <div class="stone-card">
                <p class="eyebrow">
                  {stone.name} <span class="stage-count">{i + 1} / {stones.length}</span>
                </p>
                <p class="stone-card-title">Argyle Pink Diamond</p>
                <dl class="stone-card-specs">
                  <div>
                    <dt>Carat</dt>
                    <dd>{stone.carat}</dd>
                  </div>
                  <div>
                    <dt>Argyle colour grade</dt>
                    <dd>{stone.argyleColourGrade}</dd>
                  </div>
                  <div>
                    <dt>Clarity</dt>
                    <dd>{stone.clarity}</dd>
                  </div>
                </dl>
                <a class="stone-card-link" href={`#${stone.id}`}>
                  Full specifications
                </a>
              </div>
            </div>
          </div>
        ))
      }

      <div class="stage stage-outro" data-stage="outro">
        <div class="container">
          <p class="eyebrow">The Collection</p>
          <p class="stage-lede">
            Each stone is accompanied by its Argyle certificate, GIA report and independent
            valuation.
          </p>
          <div class="outro-actions">
            <a class="button-primary" href="#collection">View the Collection</a>
            <a class="button-ghost" href="#enquiry">Register Interest</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cinema-track {
    /* Tall track: scrolling through it drives the video playhead. */
    height: 520vh;
  }

  .cinema-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .cinema-video,
  .cinema-fallback,
  .cinema-fallback :global(picture),
  .cinema-fallback :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* The fallback image sits behind the video; if the video renders, it simply
     covers the image. When scrubbing is unavailable the video is hidden. */
  .cinema-fallback {
    z-index: -3;
  }

  .cinema.no-video .cinema-video {
    display: none;
  }

  .cinema.no-video .cinema-track {
    height: auto;
  }

  .cinema.no-video .cinema-viewport {
    position: relative;
  }

  .cinema.no-video .stage-stone,
  .cinema.no-video .stage-outro {
    display: none;
  }

  .cinema-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        var(--bg) 3%,
        color-mix(in srgb, var(--bg) 45%, transparent) 40%,
        color-mix(in srgb, var(--bg) 20%, transparent) 100%
      );
  }

  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 9vh, 6rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(1.25rem);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      visibility 0s linear 0.5s;
    pointer-events: none;
  }

  .stage.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      visibility 0s;
    pointer-events: auto;
  }

  .stage .container {
    width: 100%;
  }

  .stage-lede {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
  }

  .scroll-cue {
    margin-top: 2.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .scroll-cue span {
    display: block;
    width: 1px;
    height: 2.4rem;
    background: linear-gradient(to bottom, transparent, var(--accent));
    animation: cue 2.2s ease-in-out infinite;
  }

  @keyframes cue {
    0%,
    100% {
      transform: scaleY(0.5);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue span {
      animation: none;
    }
  }

  .stone-card {
    max-width: 26rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 1.75rem 2rem 2rem;
  }

  .stage-count {
    color: var(--text-muted);
    letter-spacing: 0.2em;
    margin-left: 0.6rem;
  }

  .stone-card-title {
    font-family: var(--serif);
    font-size: 1.7rem;
    margin-top: 0.5rem;
  }

  .stone-card-specs {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }

  .stone-card-specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.65rem;
  }

  .stone-card-specs dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .stone-card-specs dd {
    font-size: 0.85rem;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .stone-card-link {
    display: inline-block;
    margin-top: 1.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .outro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .button-primary,
  .button-ghost {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.85rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--accent-deep);
  }

  .button-primary {
    background: var(--accent);
    color: #241318;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--text);
    color: #241318;
  }

  .button-ghost {
    color: var(--text);
  }

  .button-ghost:hover,
  .button-ghost:focus-visible {
    border-color: var(--text);
  }
</style>

<script>
  const cinema = document.querySelector<HTMLElement>('.cinema');
  const track = cinema?.querySelector<HTMLElement>('.cinema-track');
  const video = cinema?.querySelector<HTMLVideoElement>('.cinema-video');
  const stages = cinema ? Array.from(cinema.querySelectorAll<HTMLElement>('.stage')) : [];

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Scroll progress → [video time fraction, active stage].
   * Plateaus hold the playhead still while a stone card is displayed.
   */
  const KEYFRAMES: Array<{ at: number; time: number; stage: string | null }> = [
    { at: 0.0, time: 0.0, stage: 'intro' },
    { at: 0.12, time: 0.0, stage: 'intro' },
    { at: 0.2, time: 0.3, stage: 'stone-0' },
    { at: 0.36, time: 0.3, stage: 'stone-0' },
    { at: 0.44, time: 0.6, stage: 'stone-1' },
    { at: 0.6, time: 0.6, stage: 'stone-1' },
    { at: 0.68, time: 0.92, stage: 'stone-2' },
    { at: 0.84, time: 0.92, stage: 'stone-2' },
    { at: 0.9, time: 1.0, stage: 'outro' },
    { at: 1.0, time: 1.0, stage: 'outro' },
  ];

  function mapProgress(p: number): { time: number; stage: string | null } {
    for (let i = 1; i < KEYFRAMES.length; i++) {
      const a = KEYFRAMES[i - 1];
      const b = KEYFRAMES[i];
      if (p <= b.at) {
        const span = b.at - a.at || 1;
        const local = (p - a.at) / span;
        return { time: a.time + (b.time - a.time) * local, stage: b.stage };
      }
    }
    const last = KEYFRAMES[KEYFRAMES.length - 1];
    return { time: last.time, stage: last.stage };
  }

  function disableCinema() {
    cinema?.classList.add('no-video');
  }

  if (!cinema || !track || !video || reducedMotion) {
    disableCinema();
  } else {
    video.addEventListener('error', disableCinema);

    let duration = 0;
    let targetTime = 0;
    let currentTime = 0;
    let activeStage: string | null = null;
    let ticking = false;

    function setStage(stage: string | null) {
      if (stage === activeStage) return;
      activeStage = stage;
      for (const el of stages) {
        el.classList.toggle('is-active', el.dataset.stage === stage);
      }
    }

    function readScroll() {
      const rect = track!.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      const mapped = mapProgress(p);
      targetTime = mapped.time * duration;
      setStage(mapped.stage);
    }

    // Smooth the playhead toward the scroll target so scrubbing feels
    // weighted rather than jittery.
    function animate() {
      if (duration > 0) {
        currentTime += (targetTime - currentTime) * 0.18;
        if (Math.abs(targetTime - currentTime) > 0.005) {
          try {
            video!.currentTime = currentTime;
          } catch {
            /* seek not ready yet */
          }
        }
      }
      requestAnimationFrame(animate);
    }

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration || 0;
      readScroll();
    });
    if (video.readyState >= 1) {
      duration = video.duration || 0;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            readScroll();
          });
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', readScroll, { passive: true });

    readScroll();
    requestAnimationFrame(animate);
  }
</script>
