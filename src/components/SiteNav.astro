---
import { stones } from '../data/stones';
---

<header class="site-nav">
  <nav class="container nav-inner" aria-label="Page sections">
    <a class="wordmark" href="#top">The Argyle Collection</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Toggle navigation"
    >
      <span></span><span></span>
    </button>
    <ul id="nav-links" class="nav-links">
      <li><a href="#collection">The Collection</a></li>
      {stones.map((stone) => <li><a href={`#${stone.id}`}>{stone.shortTitle}</a></li>)}
      <li><a href="#about-the-sale">The Sale</a></li>
      <li><a class="nav-cta" href="#enquiry">Enquire</a></li>
    </ul>
  </nav>
  <span class="scroll-progress" aria-hidden="true"></span>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--text);
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
  }

  .nav-links a {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--text);
  }

  .nav-links a.is-current {
    color: var(--accent);
  }

  .scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: linear-gradient(to right, var(--accent-deep), var(--accent));
    transform: scaleX(0);
    transform-origin: left;
    z-index: 1;
  }

  .nav-cta {
    color: var(--accent) !important;
    border: 1px solid var(--accent-deep);
    padding: 0.45rem 1.1rem;
    border-radius: 2px;
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    color: var(--bg) !important;
    background: var(--accent);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 1px;
    width: 1.4rem;
    margin-inline: auto;
    background: var(--text);
    transition: transform 0.25s ease;
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--line);
      padding-block: 0.5rem;
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links a {
      display: block;
      padding: 0.85rem var(--gutter);
    }

    .nav-cta {
      border: 0;
      margin: 0.5rem var(--gutter);
      text-align: center;
      border: 1px solid var(--accent-deep);
    }

    .nav-toggle[aria-expanded='true'] span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    links?.classList.toggle('is-open', !open);
  });

  links?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') {
      toggle?.setAttribute('aria-expanded', 'false');
      links.classList.remove('is-open');
    }
  });

  // Hairline reading-progress indicator under the nav.
  const progress = document.querySelector<HTMLElement>('.scroll-progress');
  let progressTick = false;
  function paintProgress() {
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
    progress?.style.setProperty('transform', `scaleX(${p.toFixed(4)})`);
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!progressTick) {
        progressTick = true;
        requestAnimationFrame(() => {
          progressTick = false;
          paintProgress();
        });
      }
    },
    { passive: true }
  );
  paintProgress();

  // Highlight the nav link for the section currently in view.
  const navAnchors = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]')
  );
  const byId = new Map(navAnchors.map((a) => [a.getAttribute('href')!.slice(1), a]));
  const watched = Array.from(byId.keys())
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of navAnchors) a.classList.remove('is-current');
        byId.get(entry.target.id)?.classList.add('is-current');
      }
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  watched.forEach((el) => sectionObserver.observe(el));
</script>
