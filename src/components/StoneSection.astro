---
import { Image } from 'astro:assets';
import type { Stone } from '../data/stones';

interface Props {
  stone: Stone;
  /** Position in the page's numbered sections, e.g. 2 → "02". */
  number: number;
}

const { stone, number } = Astro.props;
const sectionNo = String(number).padStart(2, '0');

const provenance: Array<[string, string]> = [
  ['Origin', stone.provenance.origin],
  ['Tender history', stone.provenance.tenderHistory],
  ['Chain of custody', stone.provenance.chainOfCustody],
];

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/stone-*.jpg', {
  eager: true,
});

function imageFor(key: string): ImageMetadata {
  const match = images[`../assets/${key}.jpg`];
  if (!match) throw new Error(`Missing asset: src/assets/${key}.jpg`);
  return match.default;
}

const specs: Array<[string, string]> = [
  ['Carat weight', stone.carat],
  ['Argyle colour grade', stone.argyleColourGrade],
  ['GIA colour grade', stone.giaColourGrade],
  ['Clarity', stone.clarity],
  ['Cut / shape', stone.cutShape],
  ['Argyle certificate no.', stone.argyleCertificateNo],
  ['GIA report no.', stone.giaReportNo],
  ['Argyle lot / inscription no.', stone.argyleLotInscriptionNo],
];
---

<section id={stone.id} class="stone" aria-labelledby={`${stone.id}-heading`}>
  <div class="container">
    <p class="eyebrow">{sectionNo} · {stone.name}</p>
    <h2 id={`${stone.id}-heading`}>Argyle Pink Diamond · {stone.name}</h2>

    <div class="stone-grid">
      <figure class="gallery">
        <Image
          src={imageFor(stone.image)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 92vw, 44vw"
          alt={stone.imageAlt}
          loading="lazy"
        />
        <figcaption>
          [TODO: replace with the attached photography for {stone.name} — current image is an
          AI-generated placeholder and must not be shown to buyers]
        </figcaption>
      </figure>

      <div class="details">
        <h3>Specifications</h3>
        <table class="spec-table">
          <tbody>
            {
              specs.map(([label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">Price</th>
              <td class="poa">Price on application</td>
            </tr>
          </tbody>
        </table>

        <h3>Provenance</h3>
        <ol class="timeline">
          {
            provenance.map(([label, text]) => (
              <li>
                <span class="timeline-label">{label}</span>
                <p class="prose">{text}</p>
              </li>
            ))
          }
        </ol>

        <h3>Documentation</h3>
        <ul class="documents">
          {
            stone.documents.map((doc) => (
              <li>
                <a href={doc.href} download>
                  {doc.label} (PDF)
                </a>
                {doc.todo && <span class="doc-todo">{doc.todo}</span>}
              </li>
            ))
          }
        </ul>
        <p class="verify">
          Reports are independently verifiable via
          <a href="https://www.gia.edu/report-check-landing" rel="noopener">GIA Report Check</a>
          and the Argyle Pink Diamonds registry.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .stone {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  .stone-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .stone-grid {
      grid-template-columns: 1fr;
    }
  }

  .gallery :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .gallery figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .details h3 {
    margin-top: 2.25rem;
  }

  .details h3:first-child {
    margin-top: 0;
  }

  .details p {
    margin-top: 0.75rem;
  }

  .spec-table {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .spec-table th,
  .spec-table td {
    text-align: left;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
    vertical-align: top;
  }

  .spec-table th {
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-right: 1.5rem;
    padding-top: 0.85rem;
    white-space: nowrap;
  }

  .spec-table td {
    color: var(--text);
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .poa {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .timeline {
    list-style: none;
    margin-top: 1.25rem;
    border-left: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    padding-left: 1.5rem;
    display: grid;
    gap: 1.4rem;
  }

  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 3.5px);
    top: 0.45em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-deep);
  }

  .timeline-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .timeline .prose {
    margin-top: 0;
    font-size: 0.92rem;
  }

  .verify {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .documents {
    list-style: none;
    margin-top: 1rem;
  }

  .documents li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .doc-todo {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
