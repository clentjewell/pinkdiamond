---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ScrollCinema from '../components/ScrollCinema.astro';
import Collection from '../components/Collection.astro';
import StoneSection from '../components/StoneSection.astro';
import AboutSale from '../components/AboutSale.astro';
import Enquiry from '../components/Enquiry.astro';
import { stones } from '../data/stones';

const title = 'Three Argyle Pink Diamonds — Private Treaty Sale';
const description =
  'Three certified Argyle pink diamonds offered by private treaty. Each stone is accompanied by its Argyle certificate, GIA report and independent valuation. Enquiries in confidence.';
---

<BaseLayout title={title} description={description} ogImage="/og-image.jpg">
  <SiteNav />
  <main>
    <ScrollCinema />
    <Collection />
    {stones.map((stone) => <StoneSection stone={stone} />)}
    <AboutSale />
    <Enquiry />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>
        The Argyle Collection · Private treaty sale · All documentation verifiable with GIA and
        the Argyle Pink Diamonds registry.
      </p>
    </div>
  </footer>
</BaseLayout>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>

<script>
  // Gentle scroll-reveal for content below the cinema. Elements only get the
  // hidden state once JS runs, so a no-JS visit sees everything immediately.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll(
      [
        'main section:not(.cinema) .eyebrow',
        'main section:not(.cinema) h2',
        'main section:not(.cinema) .intro',
        '.cards > li',
        '.stone-grid > *',
        '.columns > *',
        '.enquiry-grid > *',
      ].join(', ')
    );

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
    );

    targets.forEach((el, i) => {
      el.classList.add('reveal');
      (el as HTMLElement).style.transitionDelay = `${(i % 3) * 90}ms`;
      observer.observe(el);
    });
  }
</script>
